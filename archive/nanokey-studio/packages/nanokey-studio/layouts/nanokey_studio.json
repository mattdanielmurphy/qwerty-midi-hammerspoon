      { "id": "pad_3", "index": 3, "note": 38, "name": "Clap", "chord": "iii (Mediant)", "macro": "Rewind", "typeClass": "pad-trigger" },
      { "id": "pad_4", "index": 4, "note": 39, "name": "Hat Cl", "chord": "IV (Subdom)", "macro": "Forward", "typeClass": "pad-trigger" },
      { "id": "pad_5", "index": 5, "note": 40, "name": "Hat Op", "chord": "V (Dominant)", "macro": "Left Half", "typeClass": "pad-trigger" },
